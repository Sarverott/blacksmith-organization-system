{
  "name": "blacksmith-organization-system",
  "version": "1.9.2",
  "description": "Blacksmith Organization System (BOS) core: the workshop as code - build its base, listen to its changes, inspect it as one coherent environment",
  "keywords": [
    "bos",
    "blacksmith",
    "organization",
    "system",
    "workshop",
    "forge",
    "projects"
  ],
  "homepage": "https://github.com/Sarverott/blacksmith-organization-system#readme",
  "bugs": {
    "url": "https://github.com/Sarverott/blacksmith-organization-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarverott/blacksmith-organization-system.git"
  },
  "license": "MIT",
  "author": "Sett Sarverott <sett@sarverott.com> (http://sarverott.com)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bos": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "task",
    "bos": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "commit": "cz",
    "prepare": "husky",
    "prepack": "npm run build"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@ai-sdk/xai": "^5.0.39",
    "@anthropic-ai/sdk": "^1.5.0",
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@go-task/cli": "^3.45.4",
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.19.2",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.4.6",
    "bulma": "^1.0.4",
    "chromadb": "^3.5.0",
    "commander": "^15.0.0",
    "commitizen": "^4.3.2",
    "composerize": "^1.7.6",
    "cosmiconfig": "^10.0.1",
    "decomposerize": "^1.4.4",
    "dockerode": "^5.0.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "inquirer": "^12.11.1",
    "isomorphic-git": "^1.44.11",
    "marked": "^18.1.3",
    "octokit": "^5.0.5",
    "ollama": "^0.6.4",
    "openai": "^7.52.0",
    "openapi-typescript": "^7.13.0",
    "react": "^19.3.1",
    "snyk": "^1.1308.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ssh2": "^1.17.0",
    "turndown": "^7.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.2",
    "vue": "^3.5.45",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
