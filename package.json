{
  "name": "blacksmith-organization-system",
  "version": "0.6.1",
  "description": "Blacksmith Organization System (BOS) core: the workshop as code - build its base, listen to its changes, inspect it as one coherent environment",
  "keywords": [
    "bos",
    "blacksmith",
    "organization",
    "system",
    "workshop",
    "forge",
    "projects"
  ],
  "homepage": "https://github.com/Sarverott/blacksmith-organization-system#readme",
  "bugs": {
    "url": "https://github.com/Sarverott/blacksmith-organization-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarverott/blacksmith-organization-system.git"
  },
  "license": "MIT",
  "author": "Sett Sarverott <sett@sarverott.com> (http://sarverott.com)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bos": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "bos": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "commit": "cz",
    "prepare": "husky",
    "prepack": "npm run build"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@types/node": "^24.0.0",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "inquirer": "^12.11.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  }
}
